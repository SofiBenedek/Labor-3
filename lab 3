#include <stdio.h>

int main(){

    int n;

    scanf("%d", &n);
    int lnp = n;
    int lkn = n;
    do
    {
        if (n > 0 && n < lnp)
        {
                lnp = n;
        }else if (n < 0 && n > lkn)
        {
                lkn = n; 
        }
    }while (scanf("%d", &n) == 1);
    printf("%d %d",lkn, lnp);
    

    return 0;
}

